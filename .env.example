TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=123456789,987654321
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
# Any OpenAI-compatible chat-completions API: do not include /chat/completions.
# OpenRouter: https://openrouter.ai/api/v1 with an sk-or-v1 key.
MODEL_BASE_URL=https://api.deepseek.com
# Optional SOCKS5/HTTP proxy for model calls only (socks5h keeps DNS at the proxy).
# Needed when the provider is blocked; use an exit outside the blocking region.
MODEL_PROXY=
SOCKS5_PROXY=socks5h://127.0.0.1:1080
PENNY_LOG_LEVEL=DEBUG
PENNY_LOG_FILE=logs/penny.log
# Opt in only when debugging conversation content (messages, model output, products).
PENNY_LOG_CONTENT=0
# One wall-clock budget for initial store checks and follow-up searches.
PENNY_STORE_DEADLINE=30
# Local SQLite memory. Defaults: conversation context 30 min, complete-result cache 10 min.
PENNY_DB_FILE=data/penny.sqlite3
PENNY_SESSION_TTL=1800
PENNY_CACHE_TTL=600
# Background watch checks: seconds between passes (0 disables them), startup delay,
# and the maximum number of watched products checked per pass.
PENNY_WATCH_INTERVAL=10800
PENNY_WATCH_START_DELAY=300
PENNY_WATCH_LIMIT=20
# Optional: true, false, or virtual. The OS-safe default supports Lenta WebGL.
# PENNY_BROWSER_HEADLESS=virtual
