#!/bin/sh
# Keep platform-specific interpreters and native wheels out of each other's way.
set -eu
cd "$(dirname "$0")/.."
if [ "$(uname -s)" != Linux ]; then
  echo 'Penny runs on Linux; run this inside the Linux environment.' >&2
  exit 1
fi
export UV_PROJECT_ENVIRONMENT="$PWD/.venv-linux-$(uname -m)"
if ! command -v uv >/dev/null 2>&1; then
  echo 'Install uv first: https://docs.astral.sh/uv/getting-started/installation/' >&2
  exit 1
fi
exec uv "$@"
